    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "flags:sync": "ts-node scripts/flags-sync.ts",
    "lint": "eslint src",
    "start": "medusa start",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit --passWithNoTests=false",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit:coverage": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageReporters=text-summary --silent --runInBand --forceExit"
  },
